      "parameters": {
        "jsCode": "let text = \"\";\ntry { \n    // Try both possible names for your PDF node\n    text = ($(\"Extract from PDF\") || $(\"Extract Text from PDF/CSV\")).first().json.text || \"\";\n} catch (e) {\n    console.log(\"PDF node not found\");\n}\n\nlet news = \"\";\ntry {\n    // Try to get news headlines\n    const newsItems = $(\"Fetch Market News\").all();\n    news = newsItems.map(i => i.json.articles?.map(a => a.title).join(\". \")).join(\" \");\n} catch (e) {\n    console.log(\"News node not found\");\n}\n\n// Combine them\nconst compiledStrategy = `\nINTERNAL STRATEGY:\n${text}\n\nEXTERNAL MARKET CONTEXT (NEWS):\n${news}\n`;\n\nreturn [{ json: { id: \"current-strategy\", strategy_text: compiledStrategy } }];\n"
      },
