    {
      "parameters": {
        "jsCode": "const dbCandidates = $items(\"Fetch All Candidates\").map(item => item.json);\n\nlet dbStrategy = \"Standard BMW Logistics Excellence Strategy\";\ntry {\n  // Handle potential name variants (Fetch Latest Strategy or Fetch Latest Strategy1)\n  const strategyNode = $(\"Fetch Latest Strategy\") || $(\"Fetch Latest Strategy1\");\n  dbStrategy = strategyNode.first().json.strategy_text || dbStrategy;\n} catch (e) {\n  console.log(\"Strategy node not found, using default\");\n}\n\nconst webhookData = $items(\"Webhook\")[0]?.json?.body || {};\nconst roleId = webhookData.role_id || \"logistics_lead\";\n\nconst jobDescriptions = {\n  \"logistics_lead\": {\n    \"title\": \"Senior Lead, Production & Logistics Excellence — VP Powertrain Operations\",\n    \"core_requirements\": [\"Lean Manufacturing\", \"Supply Chain Management\", \"Crisis Management\", \"Cross-functional Leadership\", \"Operational Excellence\", \"Board-level Stakeholder Management\"],\n    \"full_description\": \"We are seeking an exceptional executive to lead our Powertrain Operations division through transformational change. Oversee 200+ engineers across 3 manufacturing sites...\"\n  }\n};\n\nconst candidatePool = dbCandidates.map(c => ({\n  id: c.id,\n  name: c.full_name,\n  current_role: c.current_job_title,\n  company: c.company || \"BMW Group\",\n  experience_years: c.experience_years || 10,\n  avatar_initials: (c.full_name || \"?\").split(\" \").map(n => n[0]).join(\"\").toUpperCase(),\n  skills: c.skills_json || [],\n  background: c.cv_text || \"\",\n  bio: c.parsed_candidate_json?.bio || {}\n}));\n\nreturn [{\n  json: {\n    selected_jd: jobDescriptions[roleId] || jobDescriptions[\"logistics_lead\"],\n    persisted_strategy: dbStrategy,\n    candidate_pool: candidatePool,\n    current_team_metrics: webhookData.team_metrics || { digital_fluency: 4.2, crisis_resilience: 6.8 }\n  }\n}];"
      },
