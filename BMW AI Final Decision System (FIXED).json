    {
      "parameters": {
        "jsCode": "\nconst prepData = $('Prepare Data1').first().json;\nconst jdOutput = $('JD Context Agent2').first().json.output;\nconst cvOutput = $('CV Scoring Agent').first().json.output;\nconst decisionOutput = $('Decision Intelligence Agent').first().json.output;\nconst candidatePool = prepData.candidate_pool;\n\nconst keyMap = {\n  'automotive_continuity': 'automotive-continuity',\n  'transformation': 'transformation',\n  'supply_chain_crisis': 'supply-chain-crisis'\n};\n\nconst candidates = cvOutput.scored_candidates.map(scored => {\n  const base = candidatePool.find(c => c.id === scored.id) || {};\n  const fitScores = {}; const riskScore = {}; const reasoning = {};\n  for (const [nKey, feKey] of Object.entries(keyMap)) {\n    fitScores[feKey] = scored.fitScores?.[nKey] ?? 50;\n    riskScore[feKey] = scored.riskScores?.[nKey] ?? 5;\n    reasoning[feKey] = scored.reasoning?.[nKey] ?? '';\n  }\n  return {\n    id: scored.id, name: scored.name, currentRole: base.current_role || '', company: base.company || 'BMW Group',\n    yearsExperience: base.experience_years || 10, avatarInitials: base.avatar_initials || '?',\n    traits: scored.traits, fitScores, riskScore, reasoning\n  };\n});\n\nconst decisions = {};\nfor (const [nKey, feKey] of Object.entries(keyMap)) {\n  decisions[feKey] = decisionOutput[nKey] || {};\n}\n\nreturn [{\n  json: {\n    status: \"success\",\n    data: {\n      candidates: candidates,\n      decisions: decisions,\n      weights: Object.fromEntries(Object.entries(keyMap).map(([nk, fk]) => [fk, jdOutput[nk]?.weights || {}]))\n    }\n  }\n}];"
      },
