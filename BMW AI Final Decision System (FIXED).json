      "parameters": {
        "promptType": "define",
        "text": "=Analyze this Job Description and the current Strategic Context to produce scenario-specific competency weights.\n\nJOB DESCRIPTION:\n{{ $('Prepare Data1').first().json.selected_jd.title }}\n\nSTRATEGIC CONTEXT (from DB):\n{{ $('Prepare Data1').first().json.persisted_strategy }}\n\nGenerate weights for these 3 business scenarios:\n1. supply_chain_crisis\n2. transformation\n3. automotive_continuity\n",
        "hasOutputParser": true,
